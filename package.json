{
  "name": "claim-once",
  "version": "0.2.0",
  "description": "Run a side effect at most once per operation key across processes, backed by Redis. Atomic Lua claims with leases, fencing tokens, an explicit in_doubt state and a reconcile hook. BullMQ and tool-call helpers, plus a SIGKILL crash lab.",
  "keywords": [
    "idempotency",
    "idempotent",
    "redis",
    "bullmq",
    "queue",
    "worker",
    "retry",
    "dedupe",
    "side-effects",
    "at-most-once",
    "fencing-token",
    "lease",
    "crash-test",
    "sigkill",
    "tool-calls"
  ],
  "author": "Krrish Kumar <krrishkumar200803@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krrishkumar125/claim-once.git"
  },
  "homepage": "https://github.com/Krrishkumar125/claim-once#readme",
  "bugs": {
    "url": "https://github.com/Krrishkumar125/claim-once/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "claim-once-lab": "dist/lab/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./lab": {
      "import": {
        "types": "./dist/lab/index.d.ts",
        "default": "./dist/lab/index.js"
      },
      "require": {
        "types": "./dist/lab/index.d.cts",
        "default": "./dist/lab/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "test": "vitest run",
    "lab": "npm run build && node dist/lab/cli.js",
    "check:exports": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "bullmq": ">=5",
    "ioredis": ">=5"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "bullmq": "^5.81.6",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "ioredis": "^5.11.1",
    "publint": "^0.3.25",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.73.0",
    "vitest": "^3.2.7"
  }
}
